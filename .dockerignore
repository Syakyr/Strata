# Keep the image to the source only: everything generated is re-created on
# first start (inside the container or on the /data volume).
.git

# CI never runs inside the image. Excluding it also means a workflow-only commit does not invalidate the
# builder's `COPY . .` layer - without this, editing docker-arc.yml alone costs a full ~15 minute engine
# recompile before the change is even exercised.
.github

# local Python environment (rebuilt in the image)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# setup.py outputs and downloads (engine, packs, models, logs)
/engine/
/engine-arc/
/build/
/build*/
/dist/
/packs/
/mtp/
/models/
/Strata-data/
third_party/llama.cpp/
third_party/*.zip
*.done
*.log
strata-*.json
strata-*.txt
run-*.sh
run-*.bat
